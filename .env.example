# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Bank of Georgia ---
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_CALLBACK_URL=https://your-vercel-project.vercel.app/api/callback
BOG_SUCCESS_URL=https://spot-bar.site/success
BOG_FAIL_URL=https://spot-bar.site/fail
# Optional. Defaults documented in README ("Переменные окружения для BOG").
BOG_ORDER_TTL_MINUTES=
BOG_PAYMENT_METHODS=
BOG_LANGUAGE=en
BOG_CURRENCY=GEL

# --- Admin panel (/admin) ---
ADMIN_USER=
ADMIN_PASS=
# Signs admin/erik session tokens (see lib/utils.js). Falls back to
# MANUAL_BOOKING_SECRET if unset.
ADMIN_TOKEN_SECRET=
# Legacy fallback auth for manual-booking endpoints (?key= / X-Manual-Key).
MANUAL_BOOKING_SECRET=

# --- Erik panel (/admin, second password-gated area with BOG payment logs) ---
ERIK_PANEL_PASS=

# --- Guest form intake (Tilda -> /api/payment) ---
# Optional shared-secret check on incoming booking requests.
INCOMING_FORM_TOKEN=

# --- Staff notifications (any subset can be configured; see lib/notify.js) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Verifies Telegram's webhook calls to /api/telegram-webhook.
TELEGRAM_WEBHOOK_SECRET=

GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=9955XXXXXXXX@c.us

RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Encrypts notification secrets saved from the admin panel into notify_secrets.
# Without it, only the env vars above are used (DB-stored keys are disabled).
NOTIFY_SECRET_KEY=

# --- TMDB (movie search for event posters in the admin panel) ---
TMDB_API_KEY=
