+  eid.oninput=()=>{ const v=eid.value.trim(); if(v&&KNOWN[v]){ warn.textContent='⚠️ eid «'+v+'» уже используется для «'+KNOWN[v]+'».'; warn.classList.add('show'); } else warn.classList.remove('show'); prevw(); };
